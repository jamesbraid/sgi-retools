#!/bin/sh
# Git pre-push check: compares the entries this push changes with the binaries
# (scripts/check_claims.py). Install it once per clone:
#
#   ln -s ../../scripts/pre-push .git/hooks/pre-push
#
# The checker needs the toolchain environment (MIPS objdump, pyelftools) and the
# IRIX files in root/. It runs on the host when the MIPS objdump is there,
# through CHECK_CLAIMS_RUN when that names a wrapper, and otherwise through this
# repository's tools/re-run container. When none of those can run, or root/ is
# missing, the push is refused: an unchecked push is never let through quietly.
#
# The report is printed for every class; the push is refused for a mismatch in
# a class with near-zero false positives (BLOCKING in scripts/check_claims.py)
# on an entry the push changes. A repository's scripts/check-leaks.sh, when
# present, runs first, on the lines and commit messages this push adds, and its
# failure also refuses the push.
#
# retools/re-push runs these same stages on the range it is about to push and then
# pushes with the real URL; a clone prepared by tools/setup-clone.sh has a push URL
# that only re-push gets around, so this hook is the early warning for the other cases.
#
# A graded entry (Established or Inferred) that the push adds or edits, and that names no routine or
# whose routine or binary the checker cannot find, cannot be tested: the push is refused, with the
# file and line, the reason and the fix (--block-unresolved in scripts/check_claims.py). Graded
# entries the push does not touch are never refused, however old; Unverified entries, prose with no
# grade and tables without a routine column are exempt.
#
# Copy check: a second stage compares the documentation, tables, listings and
# Python the push changes with a reference source tree, for prose or code
# copied from it and for lone names that only the reference holds. It needs a
# tool and prebuilt indexes that live outside this repository: COPY_CHECK names
# the tool (an executable taking the options of the fingerprint tool), or the
# first line of ${XDG_CONFIG_HOME:-$HOME/.config}/re-copy-check does. A name
# judged benign goes in scripts/copy-check-allow.txt, one per line; only names a
# push adds are checked. COPY_CHECK_ARGS adds options, for example --reference
# DIR or --cpus N.
#
# The stage fails closed. No tool, a tool that is not executable, a missing
# root/, a container engine or image that is unavailable, indexes that are
# missing, a tool error and a lead above the threshold all refuse the push, each
# with a message naming the cause and the fix. The one case the hook repairs
# itself is a missing or stale symbol baseline (the per-repository index of the
# names the shipped binaries carry, keyed by scripts/inventory-root.sha256):
# it builds it with the tool's --build-symbol-baselines and checks again, and
# refuses if the build fails or the tool is still not ready.
#
# Emergency opt-out: COPY_CHECK=off skips the stage. It is never the default,
# prints a warning, and retools/re-push ignores it.
# Emergency opt-out: CHECK_CLAIMS=off skips the claim check (the leak check
# still runs). Use it only when the check cannot run and the push cannot wait.
top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1
status=0
refs=$(cat)
# The leak check reads what this push adds (and its commit messages); a tool error (2) refuses too.
if [ -x scripts/check-leaks.sh ]; then
    printf '%s\n' "$refs" | scripts/check-leaks.sh --push >&2 || status=1
fi
z=0000000000000000000000000000000000000000
# push_base REMOTE_SHA LOCAL_SHA: the commit the push is measured from.
push_base() {
    if [ "$1" = "$z" ]; then
        git merge-base "$2" origin/main 2>/dev/null || git rev-list --max-parents=0 "$2" | tail -1
    else
        echo "$1"
    fi
}
copy_cfg=${XDG_CONFIG_HOME:-$HOME/.config}/re-copy-check
copy_tool=${COPY_CHECK:-}
if [ -z "$copy_tool" ] && [ -r "$copy_cfg" ]; then
    copy_tool=$(sed -n 1p "$copy_cfg")
fi
# run_copy_pass TOOL BASE HEAD PASS: one tool run; sets copy_rc, and copy_msg to its stderr.
run_copy_pass() {
    if [ "$4" = spans ]; then
        set -- "$1" "$2" "$3" --docs --symbols-baseline "$top"
    else
        set -- "$1" "$2" "$3" --docs --identifiers --symbols-baseline "$top" --ids-max-df 5
        [ -r scripts/copy-check-allow.txt ] && set -- "$@" --allow "$top/scripts/copy-check-allow.txt"
    fi
    tool=$1 cbase=$2 chead=$3
    shift 3
    errf=$(mktemp) || return 2
    # COPY_CHECK_ARGS is split on purpose.
    # shellcheck disable=SC2086
    "$tool" --ours "$top" --changed-only --base "$cbase" --head "$chead" \
        --if-ready --fail-on-lead --quiet "$@" $COPY_CHECK_ARGS </dev/null 2>"$errf"
    copy_rc=$?
    copy_msg=$(cat "$errf")
    rm -f "$errf"
    [ -n "$copy_msg" ] && printf '%s\n' "$copy_msg" >&2
    return 0
}
refuse_copy() {
    echo "pre-push: REFUSED: the copy check could not run: $1" >&2
    echo "pre-push: fix: $2" >&2
    status=1
}
if [ "$copy_tool" = off ]; then
    echo "pre-push: WARNING: COPY_CHECK=off: the copy check was SKIPPED; this push is unchecked for text copied from the reference" >&2
elif [ -z "$copy_tool" ]; then
    refuse_copy "no tool is configured" "set COPY_CHECK to the fingerprint tool, or put its path on the first line of $copy_cfg"
elif [ ! -x "$copy_tool" ]; then
    refuse_copy "the tool $copy_tool is missing or not executable" "install it, or correct COPY_CHECK or $copy_cfg"
elif [ ! -d root ] || [ -z "$(ls -A root/ 2>/dev/null)" ]; then
    refuse_copy "root/ is missing or empty, so the shipped binaries' names cannot be read" "populate root/ (IRIX_FILES.md, tools/setup-clone.sh --root DIR)"
else
    while read -r lref lsha rref rsha; do
        [ "$lsha" = "$z" ] && continue
        base=$(push_base "$rsha" "$lsha")
        # One pass for copied spans (code and prose), one for lone names. Both
        # read what the shipped binaries carry from root/ and the inventory
        # tables, so a message or a name the binaries show is not a lead.
        for pass in spans names; do
            run_copy_pass "$copy_tool" "$base" "$lsha" $pass
            if [ "$copy_rc" -eq 3 ]; then
                case $copy_msg in
                    *"container image"*) ;;
                    *"symbol baseline"*)
                        echo "pre-push: the symbol baseline is missing or stale; building it" >&2
                        if "$copy_tool" --build-symbol-baselines "$top" </dev/null >&2; then
                            run_copy_pass "$copy_tool" "$base" "$lsha" $pass
                        else
                            refuse_copy "the symbol baseline for this root manifest is missing and building it failed (above)" "fix the cause above (container engine, image, root/), then run: $copy_tool --build-symbol-baselines $top"
                            break
                        fi ;;
                esac
            fi
            case $copy_rc in
                0) ;;
                3) refuse_copy "the tool is not ready (above): nothing was checked" "make what it names available (container engine and image, indexes, symbol baseline: $copy_tool --build-symbol-baselines $top), then push again"
                   break ;;
                4) echo "pre-push: copy check ($pass) found leads (above); read each and rewrite what was copied, or push with COPY_CHECK=off once a lead is judged benign (not through re-push)" >&2
                   status=1 ;;
                *) refuse_copy "the tool failed ($pass pass, exit $copy_rc, above)" "fix the error the tool printed, then push again"
                   break ;;
            esac
        done
    done <<REFS
$refs
REFS
fi
if [ "${CHECK_CLAIMS:-on}" = off ]; then
    echo "pre-push: WARNING: CHECK_CLAIMS=off: the claims were NOT CHECKED; this push is unchecked against the binaries" >&2
    exit $status
fi
while read -r lref lsha rref rsha; do
    [ "$lsha" = "$z" ] && continue
    base=$(push_base "$rsha" "$lsha")
    git diff --quiet "$base" "$lsha" -- docs chips 2>/dev/null && continue
    if [ ! -d root ]; then
        echo "pre-push: root/ is missing, so the claims cannot be checked; populate it (IRIX_FILES.md) or push with CHECK_CLAIMS=off" >&2
        status=1
        break
    fi
    if command -v mips64-linux-gnuabi64-objdump >/dev/null 2>&1 || [ -n "$MIPS_OBJDUMP" ]; then
        set -- python3 scripts/check_claims.py
    elif [ -n "$CHECK_CLAIMS_RUN" ]; then
        set -- $CHECK_CLAIMS_RUN python3 scripts/check_claims.py
    elif [ -x tools/re-run ] && command -v "${RE_ENGINE:-podman}" >/dev/null 2>&1; then
        set -- tools/re-run python3 scripts/check_claims.py
    else
        echo "pre-push: no MIPS toolchain, no CHECK_CLAIMS_RUN and no usable tools/re-run (${RE_ENGINE:-podman} not found); the claims cannot be checked. Install podman, set CHECK_CLAIMS_RUN, or push with CHECK_CLAIMS=off" >&2
        status=1
        break
    fi
    "$@" --status all --quiet --list-unresolved --blocking --block-unresolved --changed "$base" </dev/null >&2
    rc=$?
    if [ $rc -eq 1 ]; then
        echo "pre-push: a blocking claim mismatch, or a graded entry the claim checker cannot test (above), in a changed entry; fix the entry, or push with CHECK_CLAIMS=off in an emergency" >&2
        status=1
    elif [ $rc -ne 0 ]; then
        echo "pre-push: the claim checker did not run (exit $rc); the push is refused. Push with CHECK_CLAIMS=off in an emergency" >&2
        status=1
    fi
done <<REFS
$refs
REFS
exit $status
