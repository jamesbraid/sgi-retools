#!/usr/bin/env python3
"""Write the directory index of each top-level content directory of an RE workspace.

    retools/tools/re-run python3 retools/tools/docs-index [--repo DIR] [--check]

Covers devices/, platforms/, formats/, software/, questions/ and evidence/. In each, README.md gets a
table with one row per Markdown page and one per unit subdirectory: a link, the page's own title (its
first heading) and a one-line summary (the first sentence of its first paragraph, cut to about 120
characters). A subdirectory with a page of its own (README.md, registers.md or format.md) is one unit
row that links to that page. Any other subdirectory, such as a software component, becomes a heading
over a table of its pages.

The first line of a generated README says so. A README that carries the marker `<!-- keep -->` is
hand-written and left alone. A README with neither is reported and left alone, and the run fails: the
tool will not overwrite text it did not write. --check writes nothing and fails on a missing or stale
index. Nothing is read from outside the workspace and no page is modified.
"""
import argparse
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
from _workspace import find_workspace  # noqa: E402

DIRS = ('devices', 'platforms', 'formats', 'software', 'questions', 'evidence')
GENERATED = '<!-- generated by tools/docs-index; do not edit, run it again -->'
KEEP = '<!-- keep -->'
UNIT_PAGES = ('README.md', 'registers.md', 'format.md')
LIMIT = 120

HEADING = re.compile(r'^#{1,6}\s+(.*?)\s*#*\s*$')
NON_PROSE = re.compile(r'^(#|\||>|[-*+]\s|\d+[.)]\s|```|~~~|<|---|===|\[[^\]]+\]:\s)')
LINK = re.compile(r'\[([^\]]*)\]\([^)]*\)')
SENTENCE_END = re.compile(r'(?<=[.!?])\s+(?=[A-Z0-9`\[("])')


def read_lines(path):
    with open(path, encoding='utf-8', errors='replace') as f:
        return f.read().splitlines()


def clean(text):
    """Drop link targets and emphasis so a cell reads as plain text."""
    text = LINK.sub(r'\1', text)
    text = re.sub(r'(\*\*|__)(.+?)\1', r'\2', text)
    text = re.sub(r'<[^>]+>', '', text)
    return ' '.join(text.split())


def title_and_summary(path):
    """The first heading, and the first sentence of the first prose paragraph after it."""
    lines = read_lines(path)
    i = 0
    if lines and lines[0].strip() == '---':          # front matter
        for j in range(1, len(lines)):
            if lines[j].strip() == '---':
                i = j + 1
                break
    title = None
    fence = False
    while i < len(lines):
        s = lines[i].strip()
        i += 1
        if s.startswith(('```', '~~~')):
            fence = not fence
            continue
        m = None if fence else HEADING.match(s)
        if m:
            title = clean(m.group(1))
            break
    summary = ''
    block = []
    comment = False
    while i < len(lines) and not summary:
        s = lines[i].strip()
        i += 1
        if comment:
            comment = '-->' not in s
            continue
        if s.startswith('<!--'):
            comment = '-->' not in s
            continue
        if s.startswith(('```', '~~~')):
            fence = not fence
            continue
        if fence:
            continue
        if not s:
            summary = clean(' '.join(block)) if block else ''
            block = []
            continue
        if block or not NON_PROSE.match(s):
            block.append(s)
        else:
            # a table, list or quote: skip the whole block
            while i < len(lines) and lines[i].strip():
                i += 1
    else:
        if not summary and block:
            summary = clean(' '.join(block))
    if summary:
        summary = SENTENCE_END.split(summary, 1)[0]
        if len(summary) > LIMIT:
            cut = summary[:LIMIT - 3].rsplit(' ', 1)[0].rstrip(' ,;:-')
            summary = cut + '...'
    return title or os.path.splitext(os.path.basename(path))[0], summary


def cell(text):
    return text.replace('|', '\\|')


def row(label, href, path):
    title, summary = title_and_summary(path)
    return '| [%s](%s) | %s | %s |' % (cell(label), href, cell(title), cell(summary))


def pages(directory):
    return sorted(n for n in os.listdir(directory)
                  if n.endswith('.md') and n != 'README.md' and os.path.isfile(os.path.join(directory, n)))


def unit_page(directory):
    for n in UNIT_PAGES:
        if os.path.isfile(os.path.join(directory, n)):
            return n
    return None


def subdirs(directory):
    return sorted(n for n in os.listdir(directory)
                  if not n.startswith('.') and os.path.isdir(os.path.join(directory, n)))


HEADER = ['| Page | Title | Summary |', '|---|---|---|']


def render(top):
    """The text of top/README.md, or None when top holds nothing to list."""
    units, groups = [], []
    for n in pages(top):
        units.append(row(n, n, os.path.join(top, n)))
    for d in subdirs(top):
        path = os.path.join(top, d)
        main = unit_page(path)
        if main:
            units.append(row(d + '/', '%s/%s' % (d, main), os.path.join(path, main)))
            continue
        rows = [row(n, '%s/%s' % (d, n), os.path.join(path, n)) for n in pages(path)]
        if rows:
            groups.append((d, rows))
    if not units and not groups:
        return None
    out = [GENERATED, '', '# %s' % os.path.basename(top), '']
    if units:
        out += HEADER + units + ['']
    for d, rows in groups:
        out += ['## %s' % d, ''] + HEADER + rows + ['']
    return '\n'.join(out).rstrip('\n') + '\n'


def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    ap.add_argument('--repo', help='the workspace (default: $ORIGAMI_RE_WORKSPACE, the git work tree, the current directory)')
    ap.add_argument('--check', action='store_true', help='write nothing; fail on a missing or stale index')
    args = ap.parse_args()
    root = find_workspace(args.repo)
    bad = 0
    for name in DIRS:
        top = os.path.join(root, name)
        if not os.path.isdir(top):
            continue
        readme = os.path.join(top, 'README.md')
        current = None
        if os.path.isfile(readme):
            with open(readme, encoding='utf-8', errors='replace') as f:
                current = f.read()
            if KEEP in current:
                continue
            if current.split('\n', 1)[0] != GENERATED:
                print('%s/README.md: hand-written and not marked %s; add the marker or remove the file' % (name, KEEP),
                      file=sys.stderr)
                bad += 1
                continue
        want = render(top)
        if want == current:
            continue
        if args.check:
            print('%s/README.md: %s; run tools/docs-index' % (name, 'missing' if current is None else 'stale'),
                  file=sys.stderr)
            bad += 1
        elif want is None:
            os.remove(readme)
            print('removed %s/README.md' % name)
        else:
            with open(readme, 'w', encoding='utf-8') as f:
                f.write(want)
            print('wrote %s/README.md' % name)
    return 1 if bad else 0


sys.exit(main())
