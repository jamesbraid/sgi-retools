#!/usr/bin/env python3
"""Write the generated tree (gen/ and the forwarding headers) from defs/.

    defs-gen [--root DIR] [--check]

--check writes nothing and exits 1 when any committed output is missing,
stale or has no source. Exit 2 is a setup problem (a bad source file).
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from defslib import gen, loader  # noqa: E402


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--root", default=".", help="repo root holding defs/ (default: current directory)")
    ap.add_argument("--check", action="store_true", help="write nothing; fail when the committed output is stale")
    args = ap.parse_args(argv)
    if not loader.has_defs(args.root):
        print("error: %s has no defs/ directory" % args.root, file=sys.stderr)
        return 2
    repo = loader.load_repo(args.root)
    if repo.errors:
        for e in repo.errors:
            print("error: %s" % e, file=sys.stderr)
        return 2
    files, errors = gen.render(repo)
    if errors:
        for e in errors:
            print("error: %s" % e, file=sys.stderr)
        return 2
    if args.check:
        probs = gen.stale(repo, files)
        for p in probs:
            print("FAIL %s" % p)
        if probs:
            return 1
        print("generated tree is fresh: %d files" % len(files))
        return 0
    written, removed, kept = gen.write(repo, files)
    for rel in written:
        print("wrote %s" % rel)
    for rel in removed:
        print("removed %s" % rel)
    for rel in kept:
        print("warning: %s is under gen/ but was not generated; left alone" % rel, file=sys.stderr)
    print("%d files, %d written" % (len(files), len(written)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
