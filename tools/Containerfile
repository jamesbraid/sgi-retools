# Toolchain image for the reverse-engineering workspaces: MIPS binutils, DWARF
# tools and the Python libraries the scripts import. tools/re-run builds it on
# first use and runs a command in it with the repository mounted at /work.
#
# The base is pinned by digest (Debian 13 "trixie", slim). Debian packages come
# from that release's archive, so a rebuild picks up its security updates; the
# versions seen when this file was written are in the comments. Python packages
# are pinned exactly.
# Debian ships no IA-64 binutils, and its multiarch objdump leaves ia64 out. The
# Altix firmware and kernels need one, so build GNU binutils 2.44 (the release
# the Debian packages track) for ia64-linux-gnu in a throwaway stage and copy
# only objdump, readelf and nm. They land as ia64-linux-gnu-objdump etc.
FROM docker.io/library/debian:trixie-slim@sha256:1e1a22175fbf1b32157ddaf0219e1db4e5401fab2b94ed285add64d18587cd2d AS ia64-binutils
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl xz-utils \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/binutils.tar.xz https://ftp.gnu.org/gnu/binutils/binutils-2.44.tar.xz \
 && echo 'ce2017e059d63e67ddb9240e9d4ec49c2893605035cd60e92ad53177f4377237  /tmp/binutils.tar.xz' | sha256sum -c - \
 && tar -C /tmp -xf /tmp/binutils.tar.xz \
 && cd /tmp/binutils-2.44 \
 && ./configure --target=ia64-linux-gnu --prefix=/opt/ia64 --disable-nls --disable-gdb \
      --disable-gdbserver --disable-sim --disable-gprofng --disable-gas --disable-ld \
      --disable-gold --disable-werror \
 && make -j"$(nproc)" all-binutils \
 && make install-binutils

FROM docker.io/library/debian:trixie-slim@sha256:1e1a22175fbf1b32157ddaf0219e1db4e5401fab2b94ed285add64d18587cd2d

# binutils-mips64-linux-gnuabi64 (2.44) gives mips64-linux-gnuabi64-objdump,
# -readelf and -nm, which read big-endian o32, n32 and n64 objects alike;
# tools/toolchain.py looks for that prefix. dwarfdump (0.11) reads DWARF line
# tables and types. git is there for scripts that ask the repository for a
# revision. gcc (with libc6-dev) is the C compiler that tools/defs/ci-check
# compiles each workspace's decode headers with.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      binutils-mips64-linux-gnuabi64 \
      dwarfdump \
      gcc \
      git \
      libc6-dev \
      python3 \
      python3-pip \
 && rm -rf /var/lib/apt/lists/*

# pyelftools reads ELF and DWARF; pycparser is what m2c parses C with;
# spimdisasm disassembles MIPS objects (the repositories also carry it as a
# submodule); capstone disassembles raw words; unicorn runs one MIPS routine
# under emulation (tools/mips_shim.py); numpy is for the sweeps that
# post-process emulator results.
RUN python3 -m pip install --no-cache-dir --break-system-packages \
      pyelftools==0.32 \
      pycparser==2.22 \
      spimdisasm==1.42.4 \
      capstone==5.0.6 \
      unicorn==2.1.4 \
      numpy==2.2.4 \
 && python3 -c 'import capstone, elftools, numpy, pycparser, spimdisasm, unicorn' \
 && mips64-linux-gnuabi64-objdump --version >/dev/null \
 && dwarfdump --version >/dev/null \
 && cc --version >/dev/null

COPY --from=ia64-binutils /opt/ia64/bin/ia64-linux-gnu-objdump /opt/ia64/bin/ia64-linux-gnu-readelf /opt/ia64/bin/ia64-linux-gnu-nm /usr/local/bin/
RUN ia64-linux-gnu-objdump -i | grep -q ia64

WORKDIR /work
ENV PYTHONDONTWRITEBYTECODE=1
