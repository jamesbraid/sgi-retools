#!/usr/bin/env python3
"""Bring a contribution made on the GitHub mirror into the RE repository whose source of truth is the forge.

    retools/tools/ingest-pr N [--github URL] [--root DIR] [--repo DIR] [--push] [--allow-failing]
    retools/tools/ingest-pr --github-main [same options]

Run it from a clone of the RE repository (or give --repo DIR) whose `origin` is the forge. N is a pull
request number on the GitHub mirror; --github-main instead takes the commits on the mirror's `main` that
are not on `origin/main`, for a change that was merged on GitHub directly. The mirror is --github URL, else
the URL of a remote named `github` or `gh`; an SSH GitHub URL is read as https, so a public repository needs
no credentials. Nothing is ever posted to GitHub.

The tool lists the commits (hash, author, subject, files) and says whether they fast-forward onto
origin/main. If not, it rebases them onto origin/main with their authorship kept and says that the hashes
change, so GitHub will not close the pull request by itself. The result is left on the local branch
ingest/pr-N (ingest/github-main). Then each check prints PASS or FAIL:

  submodule pins   every submodule commit the change adds can be fetched from its .gitmodules URL
  leak check       leakcheck.py --range origin/main..HEAD
  setup-clone      tools/setup-clone.sh, with --root passed through
  ci-check         retools/tools/re-run retools/tools/defs/ci-check

The default is a dry run. --push pushes the result to origin main as a fast-forward (never forced), and
only when every check passed; --allow-failing pushes anyway and names the failed checks. The last lines say
what to do on GitHub.

Exit status: 0 done (checks passed, or pushed), 1 a check failed, a rebase conflict or a refused push,
2 tool error.
"""
import argparse
import os
import posixpath
import re
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
from _workspace import find_workspace  # noqa: E402


class ToolError(Exception):
    pass


def git(*args, cwd, check=True):
    p = subprocess.run(('git',) + args, capture_output=True, text=True, encoding='utf-8', cwd=cwd)
    if check and p.returncode != 0:
        raise ToolError('git %s: %s' % (' '.join(args), p.stderr.strip()))
    return p.stdout.strip() if check else p


def remote_url(ws, name):
    p = git('remote', 'get-url', name, cwd=ws, check=False)
    return p.stdout.strip() if p.returncode == 0 else None


def https_github(url):
    """An SSH or git:// GitHub URL as the https URL of the same repository; anything else unchanged."""
    m = re.fullmatch(r'(?:git@github\.com:|ssh://git@github\.com/|git://github\.com/|https?://github\.com/)'
                     r'([^/]+)/([^/]+?)(?:\.git)?/?', url)
    return 'https://github.com/%s/%s.git' % m.groups() if m else url


def github_url(ws, explicit):
    if explicit:
        return explicit
    for name in ('github', 'gh'):
        url = remote_url(ws, name)
        if url:
            return https_github(url)
    raise ToolError('no GitHub mirror: give --github URL or add a remote named github or gh')


def mirror_commit_base(mirror):
    """https://github.com/OWNER/REPO/commit/ for the mirror URL, or None when it is not a GitHub URL.

    GitHub-facing advice links only here: the forge host is private and must not appear in a public comment.
    """
    m = re.fullmatch(r'https://github\.com/([^/]+)/([^/]+?)(?:\.git)?/?', https_github(mirror))
    return 'https://github.com/%s/%s/commit/' % m.groups() if m else None


def commit_list(ws, rng):
    """[(hash, author, subject, [files])] oldest first."""
    out = git('log', '--reverse', '--name-only', '--format=%x01%H%x02%an <%ae>%x02%s', rng, cwd=ws)
    rows = []
    for block in out.split('\x01')[1:]:
        head, _, files = block.partition('\n')
        h, author, subject = head.split('\x02', 2)
        rows.append((h, author, subject, [f for f in files.split('\n') if f]))
    return rows


def show_commits(rows):
    for h, author, subject, files in rows:
        print('  %s  %s  %s' % (h[:12], author, subject))
        for f in files:
            print('      %s' % f)


def submodule_url(ws, path, origin):
    names = git('config', '--blob', 'HEAD:.gitmodules', '--get-regexp', r'^submodule\..*\.path$', cwd=ws, check=False)
    for line in names.stdout.splitlines():
        key, _, val = line.partition(' ')
        if val == path:
            name = key[len('submodule.'):-len('.path')]
            url = git('config', '--blob', 'HEAD:.gitmodules', 'submodule.%s.url' % name, cwd=ws)
            if url.startswith(('./', '../')):
                base, _, rest = origin.rpartition('/')
                return base + '/' + posixpath.normpath(posixpath.join(rest, url))
            return url
    return None


def check_submodules(ws, base, origin):
    """(ok, detail) for every gitlink the range base..HEAD adds or moves."""
    raw = git('diff', '--raw', '--no-renames', '--no-abbrev', base, 'HEAD', cwd=ws)
    pins = []
    for line in raw.splitlines():
        meta, _, path = line.partition('\t')
        fields = meta.lstrip(':').split()
        if fields[1] == '160000' and set(fields[3]) != {'0'}:
            pins.append((path, fields[3]))
    if not pins:
        return True, 'no submodule pin changed'
    bad = []
    for path, sha in pins:
        url = submodule_url(ws, path, origin)
        if not url:
            bad.append('%s %s: no .gitmodules entry' % (path, sha[:12]))
            continue
        tmp = tempfile.mkdtemp(prefix='ingest-pr-')
        try:
            git('init', '-q', tmp, cwd=ws)
            p = git('fetch', '-q', '--depth', '1', url, sha, cwd=tmp, check=False)
            if p.returncode != 0:
                bad.append('%s %s is not fetchable from %s' % (path, sha[:12], url))
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
    if bad:
        return False, '; '.join(bad)
    return True, '%d submodule pin(s) fetchable' % len(pins)


def run_cmd(cmd, ws):
    p = subprocess.run(cmd, cwd=ws)
    return p.returncode == 0, 'exit %d' % p.returncode


def run_checks(ws, base, origin, root):
    """[(name, ok, detail)]. ci-check only runs when setup-clone worked."""
    results = []
    ok, detail = check_submodules(ws, base, origin)
    results.append(('submodule pins', ok, detail))
    ok, detail = run_cmd([sys.executable, os.path.join(HERE, 'leakcheck.py'), '--range', base + '..HEAD'], ws)
    results.append(('leak check', ok, detail))
    setup = [os.path.join('tools', 'setup-clone.sh')] + (['--root', root] if root else [])
    ok, detail = run_cmd(setup, ws)
    results.append(('setup-clone', ok, detail))
    if ok:
        ok, detail = run_cmd([os.path.join('retools', 'tools', 're-run'),
                              os.path.join('retools', 'tools', 'defs', 'ci-check')], ws)
    else:
        ok, detail = False, 'not run, setup-clone failed'
    results.append(('ci-check', ok, detail))
    return results


def already_present(ws, main, head, rows):
    """None, or (how, sha-or-None): the change is already on origin/main, by patch or as a squash."""
    cherry = git('cherry', main, head, cwd=ws).splitlines()
    if cherry and all(line.startswith('-') for line in cherry):
        how = 'every commit has an equivalent patch there'
    else:
        base = git('merge-base', main, head, cwd=ws)
        files = sorted({f for r in rows for f in r[3]})
        if not files or git('diff', '--quiet', head, main, '--', *files, cwd=ws, check=False).returncode != 0:
            return None
        how = 'the files it changes are identical there, as after a squash merge'
    return how, find_equivalent(ws, main, head, rows)


def find_equivalent(ws, main, head, rows):
    """Best guess at the origin/main commit that carries the change: same subject, else same author and files."""
    base = git('merge-base', main, head, cwd=ws)
    log = commit_list(ws, base + '..' + main)
    subjects = [r[2].lower() for r in rows]
    for h, _, subject, _ in reversed(log):
        if any(s and s in subject.lower() for s in subjects):
            return h
    emails = {re.search(r'<(.*)>', r[1]).group(1) for r in rows}
    files = {f for r in rows for f in r[3]}
    for h, author, _, changed in reversed(log):
        if re.search(r'<(.*)>', author).group(1) in emails and files & set(changed):
            return h
    return None


def report_present(mirror, args, found):
    how, sha = found
    print('Already on origin/main (%s); nothing to ingest, nothing pushed.' % how)
    if sha:
        print('Matching origin/main commit: %s' % sha)
    else:
        print('No single origin/main commit could be identified by subject or author.')
    if not args.github_main:
        base = mirror_commit_base(mirror)
        print('\nOn GitHub (nothing is posted for you):')
        if sha:
            print('  Close PR #%d as already merged, linking %s . That commit appears on the mirror once '
                  'the publication run has pushed.' % (args.number, (base + sha) if base else sha))
        else:
            print('  Close PR #%d as already merged.' % args.number)
    return 0


def ingest(ws, args):
    origin = remote_url(ws, 'origin')
    if not origin:
        raise ToolError('no origin remote: run this in a clone of the forge repository')
    if git('status', '--porcelain', '--untracked-files=no', cwd=ws):
        raise ToolError('the work tree has uncommitted changes')
    mirror = github_url(ws, args.github)
    label = 'github-main' if args.github_main else 'pr-%d' % args.number
    branch = 'ingest/' + label
    git('fetch', '-q', 'origin', '+refs/heads/main:refs/remotes/origin/main', cwd=ws)
    src = 'refs/heads/main' if args.github_main else 'refs/pull/%d/head' % args.number
    git('fetch', '-q', mirror, '+%s:refs/remotes/mirror/%s' % (src, label), cwd=ws)
    head = git('rev-parse', 'refs/remotes/mirror/' + label, cwd=ws)
    main = git('rev-parse', 'origin/main', cwd=ws)
    print('source: %s %s -> %s' % (mirror, src, head[:12]))
    rows = commit_list(ws, 'origin/main..' + head)
    if not rows:
        print('Nothing to ingest: every commit is already on origin/main.')
        return 0
    print('%d commit(s) not on origin/main by hash:' % len(rows))
    show_commits(rows)
    found = already_present(ws, main, head, rows)
    if found:
        return report_present(mirror, args, found)

    fast_forward = git('merge-base', main, head, cwd=ws) == main
    rebased = not fast_forward
    if fast_forward:
        print('Fast-forward onto origin/main %s: yes, hashes are kept.' % main[:12])
        git('checkout', '-q', '-B', branch, head, cwd=ws)
    else:
        print('Fast-forward onto origin/main %s: no, origin/main has moved. Rebasing, authorship kept.' % main[:12])
        git('checkout', '-q', '-B', branch, head, cwd=ws)
        p = git('rebase', '--committer-date-is-author-date', 'origin/main', cwd=ws, check=False)
        if p.returncode != 0:
            git('rebase', '--abort', cwd=ws, check=False)
            git('checkout', '-q', '-B', branch, head, cwd=ws)
            print('REBASE FAILED: conflicts with origin/main. %s is the unrebased change; resolve by hand.\n%s'
                  % (branch, p.stdout.strip() or p.stderr.strip()))
            return 1
        kept = commit_list(ws, 'origin/main..HEAD')
        if not kept:
            git('checkout', '-q', main, cwd=ws)
            git('branch', '-q', '-D', branch, cwd=ws)
            return report_present(mirror, args, ('the rebase left no commits', find_equivalent(ws, main, head, rows)))
        print('The commits now have new hashes; GitHub will not see them as merged and will not close the PR.')
        show_commits(kept)

    results = run_checks(ws, main, origin, args.root)
    print()
    for name, ok, detail in results:
        print('%s  %s: %s' % ('PASS' if ok else 'FAIL', name, detail))
    failed = [n for n, ok, _ in results if not ok]

    pushed = False
    if args.push:
        if failed and not args.allow_failing:
            print('\nRefusing to push: %s failed. Fix the branch, or pass --allow-failing.' % ', '.join(failed))
            print('Result is on local branch %s.' % branch)
            return 1
        if failed:
            print('\nPushing with failing check(s): %s.' % ', '.join(failed))
        git('fetch', '-q', 'origin', '+refs/heads/main:refs/remotes/origin/main', cwd=ws)
        if git('merge-base', '--is-ancestor', 'origin/main', 'HEAD', cwd=ws, check=False).returncode != 0:
            print('\nRefusing to push: origin/main moved during the checks, so this is no longer a fast-forward. '
                  'Run the tool again.')
            return 1
        p = git('push', 'origin', 'HEAD:main', cwd=ws, check=False)
        if p.returncode != 0:
            print('\npush failed: %s' % p.stderr.strip())
            return 1
        pushed = True
        print('\nPushed %s to origin main.' % git('rev-parse', '--short=12', 'HEAD', cwd=ws))
    else:
        print('\nDry run: the result is on local branch %s. Pass --push to fast-forward origin main.' % branch)

    print('\nOn GitHub (nothing is posted for you):')
    new = [r[0] for r in commit_list(ws, main + '..HEAD')]
    if not rebased:
        if args.github_main:
            print('  Nothing. The commits keep their hashes, so the publication run pushes origin main back '
                  'onto the mirror as a fast-forward.')
        else:
            print('  Nothing. The PR head %s is now in main by the same hash; GitHub marks the PR merged '
                  'once the publication run pushes.' % head[:12])
    else:
        base = mirror_commit_base(mirror)
        links = ['  ' + (base + h if base else h) for h in new]
        if args.github_main:
            print('  The mirror\'s main holds the original hashes, which origin/main will not have. The '
                  'publication run will not fast-forward it: reconcile the mirror deliberately. The rebased commits, which '
                  'appear on the mirror once the publication run has pushed:')
        else:
            print('  Close PR #%d with a note that it was ingested with new hashes, linking the commits below. They appear on the mirror once the '
                  'publication run has pushed:' % args.number)
        print('\n'.join(links))
    return 0


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    ap.add_argument('number', nargs='?', type=int, help='pull request number on the GitHub mirror')
    ap.add_argument('--github-main', action='store_true',
                    help="take the commits on the mirror's main that are not on origin/main")
    ap.add_argument('--github', metavar='URL', help='the GitHub mirror (default: remote github or gh)')
    ap.add_argument('--root', help='passed to tools/setup-clone.sh')
    ap.add_argument('--repo', help='the RE repository clone (default: the current work tree)')
    ap.add_argument('--push', action='store_true', help='fast-forward origin main when every check passed')
    ap.add_argument('--allow-failing', action='store_true', help='with --push, push although a check failed')
    args = ap.parse_args(argv)
    if args.github_main == (args.number is not None):
        ap.error('give a pull request number or --github-main, not both or neither')
    if args.allow_failing and not args.push:
        ap.error('--allow-failing only means something with --push')
    try:
        return ingest(find_workspace(args.repo), args)
    except (ToolError, OSError) as e:
        print('ingest-pr: %s' % e, file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
