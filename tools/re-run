#!/bin/sh
# Run a command in the toolchain container with the workspace mounted at /work.
#
#   retools/tools/re-run [--ghidra] [--workspace DIR] [--] [COMMAND...]
#   retools/tools/re-run [--workspace DIR] --ghidra-export OBJECT [OPTIONS...]
#   retools/tools/re-run --syscalls KERNEL... [OPTIONS...]
#   retools/tools/re-run --syssgi KERNEL... [OPTIONS...]
#
#   retools/tools/re-run python3 retools/tools/inventory.py
#   retools/tools/re-run mips64-linux-gnuabi64-objdump -h root/unix
#   retools/tools/re-run                       # a shell in the container
#   retools/tools/re-run --ghidra analyzeHeadless /tmp/ghidra-projects p -import root/unix
#   retools/tools/re-run --ghidra-export root/usr/gfx/arch/IP27KONA32/libGLcore.so \
#       --decompile-symbol NAME --types ghidra/types/ctx.types.json
#
# The workspace is the repository holding root/ and evidence/, not the retools checkout this file is
# in. It is --workspace DIR, else $ORIGAMI_RE_WORKSPACE, else the git work tree around the current
# directory, else the current directory. Run it from the workspace and nothing needs setting. The
# retools checkout is also mounted read-only at /opt/retools, so its tools can be run from
# there (/opt/retools/tools/inventory.py) wherever it sits.
#
# Needs Podman (rootless is fine) and nothing else. The image is built from
# retools/tools/Containerfile the first time and again whenever that file changes; it
# is tagged with a hash of the file. --ghidra uses the optional second image,
# built from retools/tools/Containerfile.ghidra (large; fetches Ghidra from its
# release page). It has analyzeHeadless on PATH and a JDK, but not the
# toolchain: run Python tools without --ghidra. The image also carries the
# Ghidra scripts under /opt/re-scripts, built from retools/ghidra/scripts/.
#
# --ghidra-export OBJECT runs Ghidra over OBJECT, an ELF file in the
# workspace, relative to its top (a linked library, a kernel, a relocatable driver object), and
# writes decompiled C per function as JSON under .cache/ghidra-export/, naming
# the file on stdout. OPTIONS: --decompile-symbol NAME|GLOB|@0xADDR (repeat),
# --decompile-list FILE, --decompile-all, --decompile-timeout S, --types
# SPEC.json, --mdebug (import the object's .mdebug table), --bsim-db NAME --bsim-label LABEL (similarity database under
# .cache/ghidra-bsim), --timeout S, --cpus N. It builds both images. Decompiler
# and BSim output is
# navigation, not evidence. retools/tools/ghidra-export.py has the full list.
#
# --syscalls KERNEL... runs retools' syscall_table.py: the system call table of each linked
# kernel as TSV on stdout. --syssgi KERNEL... runs syssgi_selectors.py: the syssgi()
# selector dispatch. Both take --out FILE, --cross-check DIR (a directory of public lists) and
# --report FILE; see the top of each script. Kernel paths are inside the workspace (root/ works).
#
# The workspace is mounted read-write at /work, as your own user id, so
# generated files are yours. root/ (the IRIX files you copied in, see
# evidence/irix-files.md) is inside it. If root/ is a symlink to a directory elsewhere,
# that directory is mounted read-only at the path the link resolves to inside
# the container, so the link works. A link that resolves into a system
# directory of the container (/usr, /etc, /var and so on) is refused: make
# root/ a real directory instead. Links inside root/ that point outside it are
# not followed.
#
#   RE_ENGINE=CMD   container command to use instead of podman
#   RE_NOTTY=1      never allocate a terminal
#   RE_MEMORY=8g    hard memory cap for each container. Swap is capped at the same size, so
#                   a runaway job is OOM-killed inside its container instead of swapping the host.
#   RE_GHIDRA_MEMORY=16g  the same cap for --ghidra containers, which need more headroom
set -eu
# This file lives in the retools submodule and is run by that path. The container definitions,
# the Ghidra scripts and the sibling tools are found from this file (shared is retools' top); the
# workspace is not, it comes from --workspace, $ORIGAMI_RE_WORKSPACE or the current directory.
self=$(readlink -f "$0")
shared=$(dirname "$(dirname "$self")")
engine=${RE_ENGINE:-podman}
workspace=${ORIGAMI_RE_WORKSPACE:-}
ghidra=
export=
tool=
while [ $# -gt 0 ]; do
    case $1 in
        --workspace) workspace=$2; shift 2 ;;
        --ghidra) ghidra=1; shift ;;
        --ghidra-export) export=${2:?--ghidra-export needs an object}; shift 2; break ;;
        --syscalls) tool=syscall_table.py; shift; break ;;
        --syssgi) tool=syssgi_selectors.py; shift; break ;;
        --) shift; break ;;
        -h|--help) sed -n '2,/^set -eu/{/^set -eu/!p;}' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) break ;;
    esac
done
if [ -z "$workspace" ]; then
    workspace=$(git -C . rev-parse --show-toplevel 2>/dev/null || pwd)
fi
if [ ! -d "$workspace" ]; then
    printf 're-run: workspace %s is not a directory\n' "$workspace" >&2
    exit 2
fi
workspace=$(cd "$workspace" && pwd -P)

if [ -n "$export" ]; then
    case $export in "$workspace"/*) export=${export#"$workspace"/} ;; /*)
        printf 're-run: --ghidra-export: %s is outside the workspace\n' "$export" >&2; exit 2 ;; esac
    job=.cache/ghidra-export/$(date +%Y%m%d-%H%M%S)-$$
    mkdir -p "$workspace/$job"
    export RE_NOTTY=1
    # ghidra-export.py is retools' own, next to this file, reached through the /opt/retools mount.
    "$self" --workspace "$workspace" -- python3 /opt/retools/tools/ghidra-export.py prepare --job "$job" "$@" "$export" || exit $?
    "$self" --workspace "$workspace" --ghidra -- sh "$job/ghidra.sh" || exit $?
    exec "$self" --workspace "$workspace" -- python3 /opt/retools/tools/ghidra-export.py finish --job "$job"
fi

if [ -n "$ghidra" ]; then
    file=$shared/tools/Containerfile.ghidra; name=re-ghidra
else
    file=$shared/tools/Containerfile; name=re-toolchain
fi
# The Ghidra image also holds ghidra/scripts of the submodule, so they are part of its tag.
if [ -n "$ghidra" ]; then
    tag=$name:$(cat "$file" "$shared"/ghidra/scripts/* | sha256sum | cut -c1-12)
else
    tag=$name:$(sha256sum "$file" | cut -c1-12)
fi
if ! $engine image exists "$tag" >/dev/null 2>&1; then
    printf 're-run: building %s from %s\n' "$tag" "$file" >&2
    $engine build -q -t "$tag" -f "$file" "$shared" >/dev/null
fi

# A symlinked root/ gets its target bind-mounted where the link points.
mounts=
if [ -L "$workspace/root" ]; then
    target=$(readlink "$workspace/root")
    real=$(cd "$workspace/root" && pwd -P)
    case $target in /*) dest=$target ;; *) dest=$(realpath -m --no-symlinks "/work/$target") ;; esac
    case $real$dest in *[[:space:]]*|*:*|*,*)
        printf 're-run: root/ paths with spaces, colons or commas are not supported\n' >&2; exit 2 ;;
    esac
    case $dest in
        /work/*) ;;                          # already inside the workspace mount
        /|/bin|/bin/*|/boot|/boot/*|/dev|/dev/*|/etc|/etc/*|/lib*|/proc|/proc/*|/run|/run/*|/sbin|/sbin/*|/sys|/sys/*|/tmp|/tmp/*|/usr|/usr/*|/var|/var/*)
           printf 're-run: root/ points at %s, which would shadow container files; make root/ a real directory or link it elsewhere\n' "$dest" >&2
           exit 2 ;;
        *) mounts="-v $real:$dest:ro" ;;
    esac
fi

[ -z "$tool" ] || set -- python3 "/opt/retools/tools/$tool" "$@"
[ $# -gt 0 ] || set -- bash
tty=
if [ -z "${RE_NOTTY:-}" ] && [ -t 0 ] && [ -t 1 ]; then tty=-it; fi
mem=${RE_MEMORY:-8g}
if [ -n "$ghidra" ]; then mem=${RE_GHIDRA_MEMORY:-16g}; fi
# --userns=keep-id maps you to the same id inside, label=disable lets bind
# mounts work on SELinux hosts. --memory and --memory-swap are equal so the
# container gets no swap beyond its cap.
# shellcheck disable=SC2086
exec $engine run --rm $tty --memory "$mem" --memory-swap "$mem" \
    --userns=keep-id --security-opt label=disable \
    -v "$workspace:/work" -v "$shared:/opt/retools:ro" $mounts -w /work -e ORIGAMI_RE_WORKSPACE=/work \
    -e HOME=/tmp -e XDG_CONFIG_HOME=/tmp/.config "$tag" "$@"
