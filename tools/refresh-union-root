#!/usr/bin/env python3
"""Rebuild the union root store and the root manifest that names its copy-check baseline.

Usage: tools/refresh-union-root RE_ROOTS STORE

RE_ROOTS holds one directory per reverse-engineering workspace, each with a root/
tree (chips/root, kona/root, ...). STORE is rebuilt as a hardlink copy of those
trees, each under STORE/NAME/. Symlinks that do not resolve inside their own
workspace's tree are dropped, dangling ones included: a container that mounts
STORE cannot follow them. The manifest, scripts/inventory-root.sha256 in this
repository, lists every regular file under STORE as "sha256  path", sorted by path.

The store holds links only, so rebuilding it leaves the workspaces' files alone.
Refuses a STORE that holds a git checkout or overlaps RE_ROOTS.
"""
import hashlib
import os
import shutil
import subprocess
import sys

WORKSPACES = ('chips', 'crime', 'gr4', 'kona', 'kudzu', 'odsy', 'sysco', 'voyager')
REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MANIFEST = os.path.join(REPO, 'scripts', 'inventory-root.sha256')


def die(msg):
    sys.exit('refresh-union-root: ' + msg)


def inside(path, base):
    return path == base or path.startswith(base + os.sep)


def sha256(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def prune_links(store, tree, stats):
    """Drop every symlink under tree that does not resolve inside tree."""
    base = os.path.realpath(tree)
    for dirpath, dirnames, filenames in os.walk(tree):
        for name in dirnames + filenames:
            path = os.path.join(dirpath, name)
            if not os.path.islink(path):
                continue
            if not os.path.exists(path):
                reason = 'dangling'
            elif not inside(os.path.realpath(path), base):
                reason = 'outside'
            else:
                stats['kept_links'] += 1
                continue
            os.unlink(path)
            stats['dropped_' + reason] += 1
            stats['dropped_paths'].append(os.path.relpath(path, store))


def main(argv):
    if len(argv) != 2:
        die('usage: refresh-union-root RE_ROOTS STORE')
    src, store = (os.path.abspath(a) for a in argv)
    if not os.path.isdir(src) or os.path.islink(src):
        die('RE_ROOTS %s is not a directory' % src)
    if os.path.islink(store):
        die('STORE must be a real directory, not a link')
    trees = [os.path.join(src, ws, 'root') for ws in WORKSPACES]
    if any(inside(store, t) or inside(t, store) for t in trees) or inside(src, store):
        die('STORE must not overlap a workspace root/ tree')
    if os.path.exists(os.path.join(store, '.git')):
        die('STORE holds a git checkout; refusing to rebuild it')

    if os.path.isdir(store):
        shutil.rmtree(store)
    os.makedirs(store)
    for ws in WORKSPACES:
        tree = os.path.join(src, ws, 'root')
        if not os.path.isdir(tree) or os.path.islink(tree):
            die('%s/root is missing or a link' % ws)
        subprocess.run(['cp', '-al', tree, os.path.join(store, ws)], check=True)

    stats = {'kept_links': 0, 'dropped_dangling': 0, 'dropped_outside': 0,
             'dropped_paths': []}
    for ws in WORKSPACES:
        prune_links(store, os.path.join(store, ws), stats)

    entries = []
    for dirpath, dirnames, filenames in os.walk(store):
        for name in filenames:
            path = os.path.join(dirpath, name)
            if os.path.islink(path):
                continue
            entries.append((os.path.relpath(path, store).replace(os.sep, '/'), path))
    entries.sort()
    lines = ['%s  %s\n' % (sha256(path), rel) for rel, path in entries]
    tmp = MANIFEST + '.tmp'
    with open(tmp, 'w') as f:
        f.writelines(lines)
    os.replace(tmp, MANIFEST)

    size = sum(os.path.getsize(p) for _, p in entries)
    print('files: %d (%.1f GiB apparent)' % (len(entries), size / 2**30))
    print('links kept: %d' % stats['kept_links'])
    print('links dropped: %d dangling, %d leaving their workspace'
          % (stats['dropped_dangling'], stats['dropped_outside']))
    for p in stats['dropped_paths']:
        print('  dropped %s' % p)
    print('manifest: %d lines, sha256 %s'
          % (len(lines), sha256(MANIFEST)[:12]))


if __name__ == '__main__':
    main(sys.argv[1:])
