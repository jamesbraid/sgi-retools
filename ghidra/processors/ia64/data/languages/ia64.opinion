<?xml version="1.0" encoding="UTF-8"?>
<!-- An ELF object with e_machine EM_IA_64 (50), or a PE32+ image with machine 0x200 (512),
     loads with this language. -->
<opinions>
  <constraint loader="Executable and Linking Format (ELF)" compilerSpecID="default">
    <constraint primary="50" processor="IA64" endian="little" size="64"/>
  </constraint>
  <constraint loader="Portable Executable (PE)" compilerSpecID="default">
    <constraint primary="512" processor="IA64" endian="little" size="64"/>
  </constraint>
</opinions>
